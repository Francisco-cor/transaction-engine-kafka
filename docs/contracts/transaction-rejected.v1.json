{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://example.com/contracts/transactions.rejected.v1.json",
  "title": "TransactionRejected.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "schemaVersion", "occurredAt", "transactionId", "accountId", "amount", "currency", "type", "reasonCode", "metadata"],
  "properties": {
    "eventId": { "type": "string", "format": "uuid" },
    "eventType": { "const": "TransactionRejected" },
    "schemaVersion": { "const": 1 },
    "occurredAt": { "type": "string", "format": "date-time" },
    "transactionId": { "type": "string", "format": "uuid" },
    "accountId": { "type": "string", "minLength": 1 },
    "amount": { "type": "number", "exclusiveMinimum": 0 },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "type": { "enum": ["DEBIT", "CREDIT"] },
    "reasonCode": { "type": "string", "minLength": 1 },
    "metadata": { "type": "object" }
  }
}