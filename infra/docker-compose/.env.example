POSTGRES_DB=transactions
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=postgres_dev
POSTGRES_APP_USER=transaction_app
POSTGRES_APP_PASSWORD=transaction_app_dev
POSTGRES_MIGRATOR_USER=transaction_migrator
POSTGRES_MIGRATOR_PASSWORD=transaction_migrator_dev

KAFKA_EXTERNAL_PORT=9092
KAFKA_TOPIC_RETENTION_MS=604800000
KAFKA_DLT_RETENTION_MS=1209600000

REDIS_PASSWORD=redis_dev
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_dev

# Seguridad local (desactivada por defecto para dx — ver docs/security/secrets.md: Seguridad local)
# Para probar JWT/rate-limit como en threat-model, activa:
# GATEWAY_SECURITY_ENABLED=true
# TRANSACTION_SECURITY_ENABLED=true
# JWT_ISSUER_URI=http://mock-issuer:8080
# Ejemplo JWT fake para `curl -H "Authorization: Bearer <token>"` con claim `tenant=demo` y `scope=transactions:write`
# Generar token de prueba: ver services/api-gateway/src/test o usar jwt.io con issuer mock

