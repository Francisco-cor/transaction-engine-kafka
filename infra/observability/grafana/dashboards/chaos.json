{
  "title": "Chaos - 10k/20k Recovery",
  "uid": "chaos-10k",
  "tags": ["chaos", "plg"],
  "panels": [
    { "type": "timeseries", "title": "Submitted vs Committed", "targets": [{ "expr": "increase(http_server_requests_seconds_count{uri=\"/transactions\"}[1m])", "refId": "A" }, { "expr": "increase(ledger_committed_total[1m])", "refId": "B" }] },
    { "type": "stat", "title": "Missing ledger", "targets": [{ "expr": "increase(reconciliation_missing_total[5m])", "refId": "A" }] },
    { "type": "stat", "title": "Duplicates", "targets": [{ "expr": "increase(ledger_duplicate_events_total[5m])", "refId": "A" }] },
    { "type": "timeseries", "title": "Recovery p95 (recording rule job:ledger_lock_wait:p95)", "targets": [{ "expr": "job:ledger_lock_wait:p95", "refId": "A", "exemplar": true }] },
    { "type": "logs", "title": "Loki chaos kill logs", "targets": [{ "expr": "{service=~\".*ledger.*\"} |= \"kill\"", "refId": "A", "datasource": { "uid": "loki" } }] },
    { "type": "traces", "title": "Tempo trace for sampled transaction_id", "targets": [{ "expr": "{resource.service.name=\"ledger-service\"} | transaction_id=\"a1b2c3d4\"", "refId": "A", "datasource": { "uid": "tempo" } }] }
  ],
  "schemaVersion": 39
}
