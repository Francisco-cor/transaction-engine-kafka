{
  "title": "Resilience - Circuit Breaker & Retries",
  "uid": "resilience-cb",
  "tags": ["resilience"],
  "panels": [
    {
      "type": "stat",
      "title": "Circuit state (closed/open)",
      "targets": [{"expr": "resilience4j_circuitbreaker_state", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Retry attempts",
      "targets": [{"expr": "increase(resilience4j_retry_success_total[1m])", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "Bulkhead saturation",
      "targets": [{"expr": "resilience4j_bulkhead_available_concurrent_calls", "refId": "A"}]
    },
    {
      "type": "stat",
      "title": "Pod restarts",
      "targets": [{"expr": "increase(kube_pod_container_status_restarts_total[5m])", "refId": "A"}]
    },
    {
      "type": "timeseries",
      "title": "DB pool exhausted",
      "targets": [{"expr": "hikaricp_connections_pending", "refId": "A"}]
    }
  ],
  "schemaVersion": 39
}
