{
  "title": "API - Transaction Ingestion",
  "uid": "api-transaction",
  "tags": ["api", "plg"],
  "panels": [
    { "type": "timeseries", "title": "Throughput 5m (req/s)", "targets": [{ "expr": "sum(rate(http_server_requests_seconds_count{uri=\"/transactions\"}[5m]))", "refId": "A" }] },
    { "type": "timeseries", "title": "p95 latency with exemplars", "targets": [{ "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket{uri=\"/transactions\"}[5m])) by (le))", "refId": "A", "exemplar": true }] },
    { "type": "timeseries", "title": "p99 latency", "targets": [{ "expr": "histogram_quantile(0.99, sum(rate(http_server_requests_seconds_bucket{uri=\"/transactions\"}[5m])) by (le))", "refId": "A" }] },
    { "type": "stat", "title": "409 Idempotency hits", "targets": [{ "expr": "increase(http_server_requests_seconds_count{status=\"409\"}[5m])", "refId": "A" }] },
    { "type": "stat", "title": "429 Rate limited", "targets": [{ "expr": "increase(http_server_requests_seconds_count{status=\"429\"}[5m])", "refId": "A" }] },
    { "type": "timeseries", "title": "5xx errors", "targets": [{ "expr": "increase(http_server_requests_seconds_count{status=~\"5..\"}[5m])", "refId": "A" }] },
    { "type": "logs", "title": "Loki logs transaction_id", "targets": [{ "expr": "{service=\"transaction-service\"} | json | transaction_id=~\\\".+\\\"", "refId": "A", "datasource": { "uid": "loki" } }] },
    { "type": "traces", "title": "Tempo traces by transaction_id", "targets": [{ "expr": "{resource.service.name=\"transaction-service\"} | transaction_id=~\\\".+\\\"", "refId": "A", "datasource": { "uid": "tempo" } }] }
  ],
  "schemaVersion": 39
}
